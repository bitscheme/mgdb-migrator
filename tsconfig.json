{
  "compilerOptions": {
    "rootDir": "./",
    "baseUrl": "./",
    "sourceRoot": "src",
    "allowJs": false,
    "checkJs": false,
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "lib": [
      "es2021"
    ],
    "target": "es2021",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noImplicitThis": true,
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    },
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".vscode",
    "dist",
    "coverage",
    "migrations"
  ]
}
